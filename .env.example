# ── Bot (required) ────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here

# ── Dashboard OAuth2 (required for dashboard login) ───────────────────────────
# Found in Discord Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=your_client_secret_here

# URL the dashboard is accessible at (no trailing slash)
# Add this exact URL + /auth/callback as a Redirect URI in the Discord Developer Portal
DASHBOARD_URL=http://localhost:3000

# Port the dashboard runs on (default: 3000)
DASHBOARD_PORT=3000

# Random secret for signing sessions — use a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# ── Twitch Notifications (optional) ───────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# ── Database & Logging ────────────────────────────────────────────────────────
DB_PATH=./data/bot.db
LOG_LEVEL=info
